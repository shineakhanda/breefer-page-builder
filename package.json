{
  "name": "breefer",
  "version": "0.6.0",
  "private": true,
  "description": "Breefer page builder editor",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
